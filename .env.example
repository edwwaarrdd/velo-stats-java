# Defaults for every environment. Real environment variables win, and the Docker Compose files set
# the ones that matter, so this file documents the settings rather than deploying them.

HTTP_PORT=8000

# Path to the SQLite database file.
DB_DATABASE=database/database.sqlite

# Comma-separated list of origins allowed to call the API. The default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Prefix for the queue keys in Redis.
QUEUE_PREFIX=velo-stats:queues:

# Path to the rides JSON export.
RIDES_JSON_PATH=data/rides.json

# Upstream services the background checks call.
VELO_ANTWERP_STATION_INFORMATION_URL=https://gbfs.smartbike.com/antwerp/1.0/en/station_information.json
OSRM_BASE_URL=https://routing.openstreetmap.de
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
